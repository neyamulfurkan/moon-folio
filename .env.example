# Copy this file to .env and fill in real values. Never commit .env to git.

# =============================================================================
# DATABASE — Neon PostgreSQL
# =============================================================================

# Pooled connection string for runtime queries (from Neon dashboard → Connection Details)
DATABASE_URL="postgresql://user:password@ep-example-123456.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Direct (non-pooled) connection string for Prisma migrations only
DIRECT_URL="postgresql://user:password@ep-example-123456.us-east-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# =============================================================================
# AUTH — NextAuth.js v5
# =============================================================================

# Random secret string, minimum 32 characters
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-nextauth-secret-minimum-32-characters-here"

# Admin panel login email
ADMIN_EMAIL="admin@example.com"

# bcrypt hash of your admin password (NOT the plain password)
# Generate with: node -e "const bcrypt = require('bcryptjs'); bcrypt.hash('your-password', 12).then(console.log)"
ADMIN_PASSWORD_HASH="$2b$12$your-bcrypt-hash-here"

# =============================================================================
# AI / CHAT — Groq
# =============================================================================

# Groq API key from console.groq.com → API Keys
GROQ_API_KEY="gsk_your-groq-api-key-here"

# =============================================================================
# MEDIA — Cloudinary
# =============================================================================

# Your Cloudinary cloud name (from Cloudinary dashboard → Settings)
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"

# Cloudinary API key (numeric string, from Cloudinary dashboard → Settings → API Keys)
CLOUDINARY_API_KEY="123456789012345"

# Cloudinary API secret — NEVER expose to the client or commit to git
CLOUDINARY_API_SECRET="your-cloudinary-api-secret-here"

# =============================================================================
# EMAIL — Resend
# =============================================================================

# Resend API key from resend.com → API Keys
RESEND_API_KEY="re_your-resend-api-key-here"

# Email address where contact form submissions are forwarded
CONTACT_EMAIL="hello@example.com"

# =============================================================================
# PUBLIC — Safe to expose to the browser (NEXT_PUBLIC_ prefix required)
# =============================================================================

# Same value as CLOUDINARY_CLOUD_NAME above — used in client-side upload flow
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"

# Your deployed site URL — no trailing slash (falls back to https://moon.dev if not set)
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"